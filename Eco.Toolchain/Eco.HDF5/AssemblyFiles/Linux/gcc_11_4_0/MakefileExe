# Configurations

# Platform detection
PLATFORM = Windows

ifeq ($(OS), Windows_NT)
	#WINDOWS USE THESE DEFINITIONS
	RM = -rm -f
	SLASH = \\
	SWALLOW_OUTPUT = >nul 2>nul
	TOOLCHAIN = 
	TOOL = 

	TOOLCHAIN = 
	TOOL = 

else
	#LINUX USE THESE DEFINITIONS
	RM = -rm -f
	SLASH = /
	SWALLOW_OUTPUT =
	TOOLCHAIN = 
	TOOL = 
endif 

# Target configuration
ifeq ($(TARGET), 1)
	OUT_TARGET = EcoHDF5
	BASE_TARGET = Static

	CCFLAGS_TARGET = -Wall -DECO_LINUX -DECO_LIB
	LDFLAGS_TARGET = 

else
	OUT_TARGET = EcoHDF5
	BASE_TARGET = Dynamic

	CCFLAGS_TARGET = -Wall -DECO_LINUX -DECO_DLL
	LDFLAGS_TARGET =

endif

# Debug symbols configuration
ifeq ($(DEBUG), 1)
	CONFIG_TARGET = $(BASE_TARGET)Debug
else
	CONFIG_TARGET = $(BASE_TARGET)Release
endif

ifeq ($(ARCH), x86_16)
    CCFLAGS_TARGET +=
    LDFLAGS_TARGET +=
    ARCH_TARGET = x86_16
else ifeq ($(ARCH), x86)
    ARCH_TARGET = x86
else ifeq ($(ARCH), x86_64)
    ARCH_TARGET = amd64
else ifeq ($(ARCH), arm)
    CCFLAGS_TARGET +=   
    LDFLAGS_TARGET += 
    ARCH_TARGET = arm
else ifeq ($(ARCH), aarch32)
    CCFLAGS_TARGET +=   
    LDFLAGS_TARGET += 
    ARCH_TARGET = armv7
else ifeq ($(ARCH), aarch64)
    CCFLAGS_TARGET +=   
    LDFLAGS_TARGET += 
    ARCH_TARGET = armv8
else ifeq ($(ARCH), rv32)
    CCFLAGS_TARGET +=   
    LDFLAGS_TARGET += 
    ARCH_TARGET = rv32
else ifeq ($(ARCH), rv64)
    CCFLAGS_TARGET +=   
    LDFLAGS_TARGET += 
    ARCH_TARGET = rv64gcv
else ifeq ($(ARCH), mips)
    CCFLAGS_TARGET +=   
    LDFLAGS_TARGET += 
    ARCH_TARGET = mips
else ifeq ($(ARCH), mips64)
    CCFLAGS_TARGET +=   
    LDFLAGS_TARGET += 
    ARCH_TARGET = mips64
endif

# Device selection
ifdef DEVICE
    DEVICE_TARGET = $(DEVICE)$(SLASH)
endif

# Include directories
INC = \
/I ..$(SLASH)..$(SLASH)..$(SLASH)HeaderFiles \
/I ..$(SLASH)..$(SLASH)..$(SLASH)SharedFiles \
/I "$(ECO_FRAMEWORK)$(SLASH)Eco.Core1$(SLASH)SharedFiles" \
/I "$(ECO_FRAMEWORK)$(SLASH)Eco.System1$(SLASH)SharedFiles" \
/I "$(ECO_FRAMEWORK)$(SLASH)Eco.InterfaceBus1$(SLASH)SharedFiles" \
/I "$(ECO_FRAMEWORK)$(SLASH)Eco.MemoryManager1$(SLASH)SharedFiles" \
/I "$(ECO_FRAMEWORK)$(SLASH)Eco.FileSystemManagement1$(SLASH)SharedFiles" 

# Libraries directories
LIB_DIR = \
/LIBPATH:"..$(SLASH)..$(SLASH)..$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)$(CONFIG_TARGET)" \
/LIBPATH:"$(ECO_FRAMEWORK)$(SLASH)Eco.MemoryManager1$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)StaticRelease" \
/LIBPATH:"$(ECO_FRAMEWORK)$(SLASH)Eco.FileSystemManagement1$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)StaticRelease"

# Source files.
SRC = \
..$(SLASH)..$(SLASH)..$(SLASH)UnitTestFiles$(SLASH)SourceFiles$(SLASH)EcoHDF5.c

# Libraries
LIBS += "00000000000000000000000042757331.lib" "0000000000000000000000004D656D31.lib" 

# Object files
OBJ = $(SRC:.c=.o)

OUT = $(OUT_TARGET)
OUT_DIR = ..$(SLASH)..$(SLASH)..$(SLASH)BuildFiles$(SLASH)$(PLATFORM)$(SLASH)$(ARCH_TARGET)$(SLASH)$(CONFIG_TARGET)

# C/C++ compiler flags
CCFLAGS = $(CCFLAGS_TARGET)
 
 # Compile flags
LDFLAGS = $(LDFLAGS_TARGET)

# Tools

CC = $(TOOL)gcc
AR = $(TOOL)gcc-ar
OC = $(TOOL)objcopy


.SUFFIXES: .c

all:  $(OUT)

.c.o:
	mkdir -p "$(subst /,\,$(OUT_DIR))"
	$(CC) $(INC) $(CCFLAGS) /c $< /Fo$@
 
$(OUT): $(OBJ)
	$(LD) $(LIB_DIR) $(LIBS) /OUT:$(OUT_DIR)$(SLASH)$(OUT) $(OBJ) $(LDFLAGS)
	$(RM) $(OBJ)

clean:

	$(RM) $(OBJ) $(OUT_DIR)$(SLASH)$(OUT)
