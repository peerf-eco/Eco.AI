      "category": "semantic",
      "query": "read and write files on disk",
      "expected_components": ["Eco.FileSystemManagement1"],
      "expected_files_substring": ["IEcoFile", "IEcoDirectory", "IEcoDrive", "IEcoFileSystem"]
    },
