{
  "_meta": {
    "purpose": "Evaluation harness for 4 chunking strategies. Each query has known-correct components/files/kinds; the metric Recall@k counts how many of those land in the top-k retrieved results.",
    "categories": {
      "semantic": "Natural-language description of capability — embeddings should shine.",
      "exact_name": "Looks up by exact identifier (interface/type/function name). BM25 should dominate.",
      "error_code": "Looks up macros / #defines / error constants. BM25 wins on exact tokens.",
      "type_layout": "Asks about a struct/typedef/data layout. Mixed signal."
    },
    "constructed_2026-05-23": "5 queries per category × 4 categories = 20 total. Half written from outside-in (LLM-style — only knowing the UI catalog descriptions), half from inside-out (knowing the actual file structure). Same person constructed them, so cross-validation on a held-out set is still recommended before believing absolute numbers.",
    "scoring": "A retrieved chunk counts as correct if BOTH component AND file substring match. We use SHORT substrings (e.g. 'IEcoFile' not 'IEcoFile.h') so they match real variants — EcoOS names files with trailing digits (IEcoFile1.h, IEcoFileInfo1.h, IEcoFileManager1.h). This was a real bug in the first dataset: substring 'IEcoFile.h' only matched 'IEcoFileSystemManagement1.h' but missed every IEcoFile1/Info1/Manager1.h. Kind filter is optional — never used in scoring (it's a tool-side affordance, not a relevance proxy)."
  },
  "queries": [
    {
      "id": "sem-01",
      "category": "semantic",
      "query": "component for calculating power and square root of a number",
      "expected_components": ["Eco.Math.C89"],
      "expected_files_substring": ["IEcoMathC89.h"]
    },
    {
      "id": "sem-02",
      "category": "semantic",
      "query": "how do I register a component on the interface bus",
      "expected_components": ["Eco.InterfaceBus1"],
      "expected_files_substring": ["IEcoInterfaceBus1.h"]
    },
    {
