# EcoOS Component Agent - Environment Variables
# 
# Скопируйте этот файл в .env и заполните значения:
#   cp env.example .env
#   nano .env

# ═══════════════════════════════════════════════════════════════════════════
# OPENROUTER CONFIGURATION (обязательно)
# ═══════════════════════════════════════════════════════════════════════════

# OpenRouter API Key
# Получите на https://openrouter.ai/keys
OPENAI_API_KEY=sk-or-v1-your-key-here

# OpenRouter Base URL
OPENROUTER_URL=https://openrouter.ai/api/v1

# ═══════════════════════════════════════════════════════════════════════════
# LLM CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Модель для генерации кода (через OpenRouter)
# Доступные: moonshotai/kimi-k2-thinking, openai/gpt-4o, anthropic/claude-3.5-sonnet
LLM_MODEL=moonshotai/kimi-k2-thinking

# ═══════════════════════════════════════════════════════════════════════════
# EMBEDDINGS CONFIGURATION (через OpenRouter API)
# ═══════════════════════════════════════════════════════════════════════════

# Модель для эмбеддингов через OpenRouter
# https://openrouter.ai/models?q=embedding
EMBEDDINGS_MODEL=qwen/qwen3-embedding-8b

# ═══════════════════════════════════════════════════════════════════════════
# RAG CONFIGURATION (V7 marketplace, sqlite-vec)
# ═══════════════════════════════════════════════════════════════════════════

# Путь к боевому индексу marketplace_index.sqlite (sqlite-vec + FTS5).
# Дефолт в контейнере — /app/marketplace_index.sqlite. См. docs/RAG_SETUP.md.
# MARKETPLACE_INDEX_PATH=/app/marketplace_index.sqlite

# Токен маркетплейса — нужен только для scripts/fetch_marketplace.py (скачивание корпуса).
# ECO_API_TOKEN=

# (Старые RAG_STORAGE / CHROMA_DB удалены 2026-06-22 вместе с ChromaDB-стеком.)

# ═══════════════════════════════════════════════════════════════════════════
# AGENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Максимальное количество итераций агента
AGENT_MAX_ITERATIONS=10

# Режим отладки (true/false)
DEBUG=false

# ═══════════════════════════════════════════════════════════════════════════
# V7 TOKEN/CALL OPTIMIZATION (см. backend/OPTIMIZATION.md)
# ═══════════════════════════════════════════════════════════════════════════

# Пин провайдера OpenRouter — включает implicit prompt-cache (замерено:
# кэш 0% → 95%, цена прогона −75%). Имя ДОЛЖНО соответствовать провайдеру
# вашей LLM_MODEL (для z-ai/glm-5.1 → "z-ai"). Пусто = роутинг по умолчанию,
# кэш не работает. Не задавать вслепую при смене модели.
OPENROUTER_PROVIDER_PIN=z-ai

# Тёплый seed на retry-хопе tester→coder (план + манифест файлов вместо одной
# строки). Помогает только когда тестер заворачивает сборку. По умолчанию off.
V7_WARM_SEED=0

# Проверенные победители — включены по умолчанию в коде, здесь только kill-switch:
#   V7_SCAFFOLD=0           — отключить пред-засев src/EcoMain.c + Makefile
#   V7_PREPULL_FRAMEWORK=0  — отключить пред-загрузку фреймворк-зависимостей
#   V7_TOOL_DEDUP=0         — отключить memo-дедуп read-only инструментов
