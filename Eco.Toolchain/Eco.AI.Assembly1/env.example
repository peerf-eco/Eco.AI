# EcoOS Component Agent - Environment Variables
# 
# Скопируйте этот файл в .env и заполните значения:
#   cp env.example .env
#   nano .env

# ═══════════════════════════════════════════════════════════════════════════
# OPENROUTER CONFIGURATION (обязательно)
# ═══════════════════════════════════════════════════════════════════════════

# OpenRouter API Key
# Получите на https://openrouter.ai/keys
OPENAI_API_KEY=sk-or-v1-your-key-here

# OpenRouter Base URL
OPENROUTER_URL=https://openrouter.ai/api/v1

# ═══════════════════════════════════════════════════════════════════════════
# LLM CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Модель для генерации кода (через OpenRouter)
# Доступные: moonshotai/kimi-k2-thinking, openai/gpt-4o, anthropic/claude-3.5-sonnet
LLM_MODEL=moonshotai/kimi-k2-thinking

# ═══════════════════════════════════════════════════════════════════════════
# EMBEDDINGS CONFIGURATION (через OpenRouter API)
# ═══════════════════════════════════════════════════════════════════════════

# Модель для эмбеддингов через OpenRouter
# https://openrouter.ai/models?q=embedding
EMBEDDINGS_MODEL=qwen/qwen3-embedding-8b

# ═══════════════════════════════════════════════════════════════════════════
# RAG CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Путь к директории с исходными файлами для RAG
RAG_STORAGE=./rag_storage

# Путь к ChromaDB векторному хранилищу
CHROMA_DB=./chroma_db

# ═══════════════════════════════════════════════════════════════════════════
# AGENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Максимальное количество итераций агента
AGENT_MAX_ITERATIONS=10

# Режим отладки (true/false)
DEBUG=false
